{
  "name": "ts6-enhanced-dev",
  "private": true,
  "description": "TS6 Enhanced development tools and bundled updater dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pwsh -NoProfile -File scripts/Test-Project.ps1 -Suite Core",
    "test:browser": "pwsh -NoProfile -File scripts/Test-Project.ps1 -Suite Browser",
    "test:native": "pwsh -NoProfile -File scripts/Test-Project.ps1 -Suite Native",
    "test:installer": "pwsh -NoProfile -File scripts/Test-Project.ps1 -Suite Installer",
    "format": "prettier --write tools",
    "format:check": "prettier --check tools"
  },
  "devDependencies": {
    "playwright": "1.60.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
